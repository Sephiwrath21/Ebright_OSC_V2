generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model attendance {
  attendance_id  Int              @id @default(autoincrement())
  user_id        Int
  date           DateTime         @db.Date
  check_in       DateTime?        @db.Timestamptz(6)
  check_out      DateTime?        @db.Timestamptz(6)
  status         String           @default("present") @db.VarChar(50)
  leave_id       Int?
  total_hours    Decimal?         @db.Decimal(5, 2)
  device_id      Int?
  devices        devices?         @relation(fields: [device_id], references: [device_id], onUpdate: NoAction, map: "fk_attendance_device")
  leave_request  leave_request?   @relation(fields: [leave_id], references: [leave_id], onUpdate: NoAction, map: "fk_attendance_leave")
  users          users            @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attendance_user")
  attendance_log attendance_log[]

  @@unique([user_id, date], map: "uq_attendance_user_date")
}

model attendance_log {
  log_id        Int         @id @default(autoincrement())
  user_id       Int
  scan_time     DateTime    @db.Timestamptz(6)
  scan_type     String      @db.VarChar(10)
  device_id     Int?
  scan_serial   String?     @db.VarChar(100)
  attendance_id Int?
  scan_time_myt DateTime?   @default(dbgenerated("(scan_time AT TIME ZONE 'Asia/Kuala_Lumpur'::text)")) @db.Timestamp(6)
  attendance    attendance? @relation(fields: [attendance_id], references: [attendance_id], onUpdate: NoAction, map: "fk_attendance_log_attendance")
  devices       devices?    @relation(fields: [device_id], references: [device_id], onUpdate: NoAction, map: "fk_log_device")
  users         users       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_log_user")

  @@unique([device_id, scan_serial], map: "uq_attendance_log_device_serial", where: raw("(scan_serial IS NOT NULL)"))
}

model bank_details {
  bank_id      Int     @id @default(autoincrement())
  user_id      Int     @unique
  bank_name    String? @db.VarChar(100)
  bank_account String? @db.VarChar(50)
  account_name String? @db.VarChar(200)
  users        users   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bank_user")
}

model branch {
  branch_id              Int                      @id @default(autoincrement())
  branch_name            String                   @db.VarChar(100)
  location               String?                  @db.VarChar(255)
  branch_code            String?                  @unique @db.VarChar(10)
  region                 String?                  @db.VarChar(10)
  branch_position        branch_position[]
  branch_operating_day   branch_operating_day[]
  devices                devices[]
  employment             employment[]
  schedule_period_status schedule_period_status[]
  manpower_schedule_attendance manpower_schedule_attendance[]
  manpower_attendance_day_lock manpower_attendance_day_lock[]
}

model department {
  department_id      Int                          @id @default(autoincrement())
  department_name    String                       @db.VarChar(100)
  department_code    String                       @unique @db.VarChar(10)
  employment         employment[]
  substep_templates  induction_substep_template[]
  workflow_templates workflow_template[]
}

model devices {
  device_id         Int              @id @default(autoincrement())
  serial_no         String           @unique @db.VarChar(100)
  branch_id         Int?
  ip_address        String?          @db.VarChar(45)
  tz_offset_minutes Int              @default(0)
  attendance        attendance[]
  attendance_log    attendance_log[]
  branch            branch?          @relation(fields: [branch_id], references: [branch_id], onUpdate: NoAction, map: "fk_devices_branch")
}

model emergency_contact {
  contract_id Int     @id(map: "emergency_contract_pkey") @default(autoincrement())
  user_id     Int
  name        String  @db.VarChar(255)
  phone       String? @db.VarChar(30)
  relation    String? @db.VarChar(50)
  email       String? @db.VarChar(255)
  address     String?
  users       users   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contract_user")
}

model resume {
  resume_id      Int     @id @default(autoincrement())
  user_id        Int     @unique
  resume_file_id String? @db.VarChar(128)
  cv_file_id     String? @db.VarChar(128)
  users          users   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_resume_user")
}

model interview_assessment {
  interview_assessment_id Int       @id @default(autoincrement())
  user_id                 Int       @unique
  int_date                DateTime? @db.Date
  overall_rate            Int?
  recommendation          String?   @db.VarChar(20)
  strength                String?
  weakness                String?
  hiring_note             String?
  users                   users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_interview_assessment_user")
}

model reference_check {
  reference_check_id Int     @id @default(autoincrement())
  user_id            Int     @unique
  ref_name           String? @db.VarChar(255)
  company            String? @db.VarChar(200)
  relationship       String? @db.VarChar(50)
  position           String? @db.VarChar(100)
  contact_number     String? @db.VarChar(30)
  email              String? @db.VarChar(255)
  users              users   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reference_check_user")
}

model medical_check {
  medical_check_id       Int     @id @default(autoincrement())
  user_id                Int     @unique
  medical_report_file_id String? @db.VarChar(128)
  result                 String? @db.VarChar(30)
  users                  users   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_medical_check_user")
}

model probation {
  probation_id                Int       @id @default(autoincrement())
  user_id                     Int       @unique
  probation_status            String?   @db.VarChar(20)
  start_date                  DateTime? @db.Date
  end_date                    DateTime? @db.Date
  confirm_date                DateTime? @db.Date
  ext_end_date                DateTime? @db.Date
  confirmation_letter_file_id String?   @db.VarChar(128)
  extension_letter_file_id    String?   @db.VarChar(128)
  // Audit trail for the HR Confirm/Extend/Stop decision (see
  // decideProbationOutcome in employeeRecordActions.ts) — the one write path
  // this feature introduces; everything else it reads is read-only from
  // ebright_hrfs. Nullable: rows written by the older updateProbationInfo
  // form flow (before this feature existed) have neither.
  decided_by                  Int?
  decided_at                  DateTime? @db.Timestamptz(6)
  users                       users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_probation_user")
  decided_by_user             users?    @relation("probation_decided_byTousers", fields: [decided_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_probation_decided_by")
}

// Live tables found on the shared hrfs database that were never declared
// here (schema drift — added directly against the DB by something outside
// this repo, not by anything in this codebase). Declared now, matching
// their real live structure exactly (columns/nullability/defaults/indexes
// confirmed via information_schema/pg_constraint), purely so `prisma db
// push` stops treating them as extra tables to drop — this doesn't change
// either table's actual data or structure, just makes the schema admit
// they exist. Neither is used anywhere in this app's own code (no FK
// constraints tie them to anything else in this schema either).
model attendance_all {
  id             Int       @id @default(autoincrement())
  employee_id    String    @db.VarChar(50)
  branch_id      Int?
  date           DateTime  @db.Date
  clock_in_time  DateTime? @db.Time
  clock_out_time DateTime? @db.Time
  status         String    @default("no record") @db.VarChar(20)
  synced_at      DateTime  @default(now()) @db.Timestamptz(6)
  scan_count     Int       @default(0)
  device_name    String?

  @@unique([employee_id, date], map: "uq_attendance_all_emp_date")
  @@index([date], map: "idx_attendance_all_date")
  @@index([branch_id], map: "idx_attendance_all_branch")
}

model od_tickets {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  count Int    @default(0)
  total Int    @default(10)
}

model documents {
  documents_id                Int     @id @default(autoincrement())
  user_id                     Int     @unique
  employment_contract_file_id String? @db.VarChar(128)
  employee_handbook_file_id   String? @db.VarChar(128)
  users                       users   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documents_user")
}

// pcb_form is constrained to TP1/TP2/TP3 by a DB-level CHECK constraint
// (chk_payroll_pcb_form, prisma/manual-sql/add_payroll.sql) not modeled
// here — Prisma has no native CHECK-constraint mapping in this schema's
// current preview features, so it's enforced purely at the Postgres level.
model payroll {
  payroll_id             Int     @id @default(autoincrement())
  user_id                Int     @unique
  epf_number             String? @db.VarChar(30)
  socso_number           String? @db.VarChar(30)
  eis_number             String? @db.VarChar(30)
  tax_number             String? @db.VarChar(30)
  pcb_form               String? @db.VarChar(3)
  pcb_attachment_file_id String? @db.VarChar(128)
  users                  users   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payroll_user")
}

// Repeatable — an employee can have many achievements over their tenure —
// so this follows leave_request/employee_rate_history's convention (own
// serial PK, user_id NOT unique) rather than resume/medical_check's 1:1
// pattern.
model achievement {
  achievement_id     Int       @id @default(autoincrement())
  user_id            Int
  name               String?   @db.VarChar(255)
  date               DateTime? @db.Date
  attachment_file_id String?   @db.VarChar(128)
  users              users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_achievement_user")

  @@index([user_id], map: "idx_achievement_user")
}

// Repeatable, same convention as achievement. Separate table from
// employee_rate_history per explicit decision — see add_salary_revision.sql.
model salary_revision {
  salary_revision_id Int       @id @default(autoincrement())
  user_id            Int
  issued_date        DateTime? @db.Date
  effective_date     DateTime? @db.Date
  current_salary     Decimal?  @db.Decimal(10, 2)
  new_salary         Decimal?  @db.Decimal(10, 2)
  reason             String?
  salary_adjustment  Decimal?  @db.Decimal(6, 2)
  approved_by        String?   @db.VarChar(100)
  attachment_file_id String?   @db.VarChar(128)
  users              users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_salary_revision_user")

  @@index([user_id], map: "idx_salary_revision_user")
}

// Repeatable, same convention as achievement/salary_revision.
model promotion {
  promotion_id       Int       @id @default(autoincrement())
  user_id            Int
  promotion_date     DateTime? @db.Date
  effective_date     DateTime? @db.Date
  current_position   String?   @db.VarChar(100)
  new_position       String?   @db.VarChar(100)
  reason             String?
  approved_by        String?   @db.VarChar(100)
  attachment_file_id String?   @db.VarChar(128)
  users              users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_promotion_user")

  @@index([user_id], map: "idx_promotion_user")
}

// Repeatable, same convention as achievement/salary_revision/promotion.
// from_location/to_location store text (branch/department/role) per
// explicit decision — see add_transfer.sql.
model transfer {
  transfer_id        Int       @id @default(autoincrement())
  user_id            Int
  type               String?   @db.VarChar(50)
  effective_date     DateTime? @db.Date
  from_location      String?   @db.VarChar(100)
  to_location        String?   @db.VarChar(100)
  reason             String?
  attachment_file_id String?   @db.VarChar(128)
  // Temporary Transfer only — the date this transfer should auto-revert the
  // employee's Branch/Department back to from_location, and when the
  // scheduled sweep (src/lib/transferAutomation.ts) actually did so. NULL
  // for every other transfer type.
  end_date           DateTime? @db.Date
  reverted_at        DateTime? @db.Timestamptz(6)
  users              users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transfer_user")

  @@index([user_id], map: "idx_transfer_user")
}

// Repeatable, same convention as achievement/salary_revision/promotion/
// transfer. status is free-text — no canonical option list exists anywhere
// in the mock for this field.
model training {
  training_id Int       @id @default(autoincrement())
  user_id     Int
  name        String?   @db.VarChar(255)
  date        DateTime? @db.Date
  status      String?   @db.VarChar(30)
  users       users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_training_user")

  @@index([user_id], map: "idx_training_user")
}

// Singleton — one row per user_id, confirmed via the mock's single-form-only
// rendering (no history list, unlike the repeatable tables above). status is
// constrained to Active/Expired/Pending by a DB-level CHECK constraint
// (chk_nda_status, add_nda.sql) not modeled here — same convention as
// payroll.pcb_form.
model nda {
  nda_id             Int       @id @default(autoincrement())
  user_id            Int       @unique
  sign_date          DateTime? @db.Date
  effective_date     DateTime? @db.Date
  status             String?   @db.VarChar(20)
  attachment_file_id String?   @db.VarChar(128)
  users              users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_nda_user")
}

// Singleton — one row per user_id, same convention as nda. duration is
// free-text (e.g. "12 months") — no structured interval type used.
model non_compete {
  non_compete_id     Int       @id @default(autoincrement())
  user_id            Int       @unique
  sign_date          DateTime? @db.Date
  expiry_date        DateTime? @db.Date
  duration           String?   @db.VarChar(50)
  attachment_file_id String?   @db.VarChar(128)
  users              users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_non_compete_user")
}

// ─── Disciplinary (4 repeatable tables, same convention as
// achievement/promotion/etc) — field configs match
// js/disciplinary-record.js's CONFIGS map (domestic-inquiry/suspension-
// letter/showcause-letter/pip), confirmed via the pre-existing
// DisciplinarySection placeholder's own "+Add a record" modal pattern for
// each. Single-line "text" fields (panel/decision/type/issued_by/status/
// supervisor) map to varchar; "textarea" fields (case_summary/reason/
// emp_response/improvement_goal/remark/review_result) map to text. PIP has
// no attachment field — not in the mock's own PIP config. ───

model domestic_inquiry {
  domestic_inquiry_id Int       @id @default(autoincrement())
  user_id             Int
  date                DateTime? @db.Date
  panel               String?   @db.VarChar(255)
  case_summary        String?
  decision            String?
  attachment_file_id  String?   @db.VarChar(128)
  users               users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_domestic_inquiry_user")

  @@index([user_id], map: "idx_domestic_inquiry_user")
}

model suspension_letter {
  suspension_letter_id Int       @id @default(autoincrement())
  user_id              Int
  start_date           DateTime? @db.Date
  end_date             DateTime? @db.Date
  type                 String?   @db.VarChar(100)
  reason               String?
  issued_by            String?   @db.VarChar(100)
  attachment_file_id   String?   @db.VarChar(128)
  users                users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_suspension_letter_user")

  @@index([user_id], map: "idx_suspension_letter_user")
}

model showcause_warning_letter {
  showcause_warning_letter_id Int       @id @default(autoincrement())
  user_id                     Int
  type                        String?   @db.VarChar(100)
  date                        DateTime? @db.Date
  issued_by                   String?   @db.VarChar(100)
  status                      String?   @db.VarChar(50)
  reason                      String?
  emp_response                String?
  attachment_file_id          String?   @db.VarChar(128)
  users                       users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_showcause_warning_letter_user")

  @@index([user_id], map: "idx_showcause_warning_letter_user")
}

model pip {
  pip_id           Int       @id @default(autoincrement())
  user_id          Int
  start_date       DateTime? @db.Date
  end_date         DateTime? @db.Date
  supervisor       String?   @db.VarChar(100)
  review_result    String?
  improvement_goal String?
  remark           String?
  users            users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pip_user")

  @@index([user_id], map: "idx_pip_user")
}

// ─── Exit (3 singleton tables, same convention as resume/medical_check/
// probation) — confirmed via the mock's single-form-only rendering for each
// (no "+Add"/history list anywhere for Resignation/Reference Letter/Exit
// Interview Notes). ───

// exit_type is constrained by a DB-level CHECK constraint
// (chk_resignation_exit_type, alter_resignation_add_exit_type.sql) not
// modeled here — same convention as payslip.type/nda.status.
model resignation {
  resignation_id        Int       @id @default(autoincrement())
  user_id               Int       @unique
  submission_date       DateTime? @db.Date
  last_working_date     DateTime? @db.Date
  reason                String?
  resign_letter_file_id String?   @db.VarChar(128)
  accept_letter_file_id String?   @db.VarChar(128)
  exit_type             String?   @db.VarChar(30)
  users                 users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_resignation_user")
}

// type is constrained to employment/reference/service by a DB-level CHECK
// constraint (chk_reference_letter_type, add_reference_letter.sql) not
// modeled here — same convention as nda.status.
model reference_letter {
  reference_letter_id   Int       @id @default(autoincrement())
  user_id               Int       @unique
  request_date          DateTime? @db.Date
  type                  String?   @db.VarChar(20)
  issued_date           DateTime? @db.Date
  issued_by             String?   @db.VarChar(100)
  remark                String?
  issued_letter_file_id String?   @db.VarChar(128)
  users                 users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reference_letter_user")
}

// No attachment field — not in the mock's own Exit Interview Notes panel.
// reason is constrained to career/compensation/relocation/personal/other by
// a DB-level CHECK constraint (chk_exit_interview_note_reason,
// add_exit_interview_note.sql) not modeled here — same convention as
// nda.status.
model exit_interview_note {
  exit_interview_note_id Int       @id @default(autoincrement())
  user_id                Int       @unique
  date                   DateTime? @db.Date
  interviewer            String?   @db.VarChar(100)
  reason                 String?   @db.VarChar(20)
  note                   String?
  users                  users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_exit_interview_note_user")
}

// ─── Employee Record singleton tables (same convention as resume/
// medical_check/probation) ───

// Repeatable — confirmed via the mock's own real "Add Another" button
// (pinfo_guardianInfo.html, id="add-guardian-btn") — same convention as
// achievement/salary_revision (own serial PK, user_id NOT unique, indexed).
model guardian_info {
  guardian_info_id Int     @id @default(autoincrement())
  user_id          Int
  name             String? @db.VarChar(255)
  relationship     String? @db.VarChar(50)
  gender           String? @db.VarChar(20)
  email            String? @db.VarChar(255)
  phone            String? @db.VarChar(30)
  address          String?
  users            users   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_guardian_info_user")

  @@index([user_id], map: "idx_guardian_info_user")
}

// payment_method/payment_frequency are constrained by DB-level CHECK
// constraints (chk_payment_info_method/chk_payment_info_frequency,
// add_payment_info.sql) not modeled here — same convention as
// nda.status/payroll.pcb_form. Deliberately separate from bank_details,
// which backs the same Payment & Bank Info page's "Bank Details" subsection.
model payment_info {
  payment_info_id   Int       @id @default(autoincrement())
  user_id           Int       @unique
  payment_method    String?   @db.VarChar(20)
  payment_frequency String?   @db.VarChar(20)
  pay_date          DateTime? @db.Date
  remark            String?
  users             users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_info_user")
}

// overall_rating is constrained by a DB-level CHECK constraint
// (chk_performance_review_rating, add_performance_review.sql) not modeled
// here — same convention as nda.status.
// Repeatable — one row per review (newest first), same shape as
// salary_revision — Active Employment's "Performance Review" form shows the
// latest row, with all rows listed in the "Performance Review History"
// table below.
model performance_review {
  performance_review_id Int       @id @default(autoincrement())
  user_id               Int
  period                String?   @db.VarChar(50)
  review_date           DateTime? @db.Date
  reviewer              String?   @db.VarChar(100)
  overall_rating        String?   @db.VarChar(30)
  comment               String?
  attachment_file_id    String?   @db.VarChar(128)
  users                 users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_performance_review_user")

  @@index([user_id], map: "idx_performance_review_user")
}

// Deliberately separate from the existing payroll model (EPF/SOCSO/EIS/Tax/
// PCB) — backs a different subsection (Basic Pay/Payslip) of a different
// tab (Finance > Payroll/Payslip vs. Onboarding's own Payroll/Finance > Tax
// Info). type is constrained by a DB-level CHECK constraint
// (chk_payslip_type, add_payslip.sql) not modeled here — same convention as
// nda.status.
// attachment_file_id is retired, per explicit decision (see conversation)
// — the single-upload Payslip widget it backed is replaced by the
// payslip_history table below (many rows per user, one per month). Left in
// place rather than dropped (no code writes to it anymore, and it was
// already null for every real employee — confirmed 0 real uploads existed
// at retirement time), same "leave old columns in place" convention as
// payroll/nda elsewhere in this schema. basic_pay/type are UNCHANGED —
// still this table's own fields, still backing Finance > Payroll/Payslip's
// "Basic Pay" subsection exactly as before.
model payslip {
  payslip_id         Int      @id @default(autoincrement())
  user_id            Int      @unique
  basic_pay          Decimal? @db.Decimal(10, 2)
  type               String?  @db.VarChar(20)
  attachment_file_id String?  @db.VarChar(128)
  users              users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payslip_user")
}

// Payslip History — Finance > Payroll/Payslip's "Payslip" subsection,
// replacing the old single-upload attachment_file_id above (see its own
// comment) — repeatable (many rows per user, one per month), following the
// same shape as achievement/training (own serial PK, user_id NOT unique).
// month is "YYYY-MM" text (e.g. "2026-08"), not a DATE column — a payslip
// covers a whole calendar month, not a specific day, and this stays
// trivially sortable/comparable as plain text without needing a synthetic
// day-of-month. upload_date is set once at creation (server-side
// new Date(), not user-entered) and never updated after — add + delete
