  status                      String                       @default("Pending") @db.VarChar(20)
  current_stage               String                       @default("Trigger") @db.VarChar(30)
  last_working_day            DateTime?                    @db.Date
  exit_interview_date         DateTime?                    @db.Date
  exit_interview_time         String?                      @db.VarChar(20)
  exit_interview_location     String?                      @db.VarChar(200)
  exit_interview_completed_at DateTime?                    @db.Timestamptz(6)
  exit_interview_notes        String?
  exit_interview_outcome      String?
  supervisor_decision         String?                      @db.VarChar(20)
  supervisor_decision_at      DateTime?                    @db.Timestamptz(6)
  resignation_letter_file_id  String?                      @db.VarChar(128)
  resigned_at                 DateTime?                    @db.Timestamptz(6)
  supervisor_user_id          Int?
  supervisor_signoff_status   String?                      @db.VarChar(20)
  supervisor_signoff_at       DateTime?                    @db.Timestamptz(6)
  supervisor_remarks          String?
  finance_remarks             String?
  final_pay_breakdown         Json?
  finance_processed_at        DateTime?                    @db.Timestamptz(6)
  finance_processed_by_id     Int?
  created_by_id               Int
  created_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)
  completed_at                DateTime?                    @db.Timestamptz(6)
  assigned_hr_id              Int?
  audit_log                   offboarding_audit_log[]
  assigned_hr                 users?                       @relation("OffboardingCaseAssignedHR", fields: [assigned_hr_id], references: [user_id], onUpdate: NoAction, map: "fk_offboarding_case_assigned_hr")
  created_by                  users                        @relation("OffboardingCaseCreatedBy", fields: [created_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_offboarding_case_creator")
  finance_processed_by        users?                       @relation("OffboardingCaseFinanceProcessor", fields: [finance_processed_by_id], references: [user_id], onUpdate: NoAction, map: "fk_offboarding_case_finance")
