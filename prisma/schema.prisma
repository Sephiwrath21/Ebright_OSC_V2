  @@index([date], map: "idx_mps_date")
  @@index([profile_id], map: "idx_mps_profile")
  @@index([schedule_type], map: "idx_mps_schedule_type")
}

// Per-slot remark for a manpower schedule. A remark belongs to a whole
// (date, slot, schedule_type) — NOT to any one staff assignment — so it is
// stored separately from manpower_schedule (which is per date+slot+position).
// This lets a slot carry a remark even when nobody is assigned to it.
model manpower_schedule_note {
  note_id       Int      @id @default(autoincrement())
  date          DateTime @db.Date
  slot_id       Int
  schedule_type String   @default("planning") @db.VarChar(10)
  remark        String
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamp(6)
  slot          slot     @relation(fields: [slot_id], references: [slot_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_msn_slot")

  @@unique([date, slot_id, schedule_type], map: "uq_msn_date_slot_type")
  @@index([date], map: "idx_msn_date")
}

model manpower_schedule_attendance {
  attendance_id Int          @id @default(autoincrement())
  date          DateTime     @db.Date
  profile_id    Int
  branch_id     Int
  status        String       @db.VarChar(10)
  locked        Boolean      @default(false)
  updated_at    DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  user_profile  user_profile @relation(fields: [profile_id], references: [profile_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_msa_profile")
  branch        branch       @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_msa_branch")

  @@unique([date, profile_id], map: "uq_msa_date_profile")
  @@index([date], map: "idx_msa_date")
  @@index([branch_id], map: "idx_msa_branch")
}

model manpower_attendance_day_lock {
  day_lock_id Int      @id @default(autoincrement())
  branch_id   Int
  date        DateTime @db.Date
  locked      Boolean  @default(true)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  branch      branch   @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_madl_branch")

  @@unique([branch_id, date], map: "uq_madl_branch_date")
  @@index([date], map: "idx_madl_date")
}

model schedule_period_status {
  schedule_period_status_id Int       @id @default(autoincrement())
  branch_id                 Int
  period_start              DateTime  @db.Date
  period_end                DateTime  @db.Date
  status                    String    @default("draft") @db.VarChar(20)
  archived_at               DateTime? @db.Timestamp(6)
  branch                    branch    @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sps_branch")

  @@unique([branch_id, period_start, period_end], map: "uq_sps_branch_period")
}

model offboarding_case {
