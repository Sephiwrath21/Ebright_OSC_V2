/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
// A branch's duty-position DEFINITIONS — stable, one row per seat per branch
// (e.g. "Coach 1" for branch 7 exists once, forever). position_type is the
// authoritative category; seat_number is the ordinal within that type.
model branch_position {
  branch_position_id Int                    @id @default(autoincrement())
  branch_id          Int
  position_type      String                 @db.VarChar(20)
  seat_number        Int
  position_label     String                 @db.VarChar(50)
  display_order      Int                    @default(0)
  branch             branch                 @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bp_branch")
  manpower_schedule  manpower_schedule[]
  days               branch_position_day[]

  @@unique([branch_id, position_type, seat_number], map: "uq_bp_branch_type_seat")
  @@index([branch_id], map: "idx_bp_branch")
}

// Per-DAY activation of a branch_position — lets seat COUNTS vary per calendar
// date (activate Coach 1-3 on Mon, Coach 1-4 on Sat) without duplicating the
// position definitions. Absence of a row for a date means that date hasn't been
// set up yet (seed by cloning the same weekday of the previous week).
model branch_position_day {
  branch_position_day_id Int             @id @default(autoincrement())
  branch_position_id     Int
  date                   DateTime        @db.Date
  is_active              Boolean         @default(true)
  branch_position        branch_position @relation(fields: [branch_position_id], references: [branch_position_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bpd_position")

  @@unique([branch_position_id, date], map: "uq_bpd_position_date")
  @@index([date], map: "idx_bpd_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model branch_operating_day {
  branch_operating_day_id Int      @id @default(autoincrement())
  branch_id               Int
  day_of_week             String   @db.VarChar(10)
  open_time               DateTime @db.Time(6)
  close_time              DateTime @db.Time(6)
  is_active               Boolean  @default(true)
  branch                  branch   @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bod_branch")
  slot                    slot[]

  @@unique([branch_id, day_of_week], map: "uq_branch_day")
}

