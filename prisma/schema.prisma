  @@index([created_at], map: "idx_offb_audit_at")
}

model workflow_template {
  id            Int                   @id @default(autoincrement())
  name          String                @db.VarChar(200)
  department_id Int
  category      String                @db.VarChar(50)
  status        String                @default("draft") @db.VarChar(20)
  trigger       String                @default("after-day-3") @db.VarChar(40)
  applies_to    Json
  created_by_id Int
  published_at  DateTime?             @db.Timestamptz(6)
  archived_at   DateTime?             @db.Timestamptz(6)
  created_at    DateTime              @default(now()) @db.Timestamptz(6)
  updated_at    DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  assignments   workflow_assignment[]
  steps         workflow_step[]
  created_by    users                 @relation("WorkflowTemplateCreatedBy", fields: [created_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_workflow_template_created_by")
  department    department            @relation(fields: [department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_workflow_template_department")

  @@index([department_id], map: "idx_workflow_template_department")
  @@index([category], map: "idx_workflow_template_category")
  @@index([status], map: "idx_workflow_template_status")
}

model workflow_step {
  id                   Int                        @id @default(autoincrement())
  workflow_template_id Int
  step_number          Int
  title                String                     @db.VarChar(200)
  description          String?
  actor_role           String                     @db.VarChar(50)
  type                 String                     @db.VarChar(30)
  due_days_after_start Int                        @default(0)
  required             Boolean                    @default(true)
  created_at           DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)
  assignment_steps     workflow_assignment_step[]
  workflow_template    workflow_template          @relation(fields: [workflow_template_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_workflow_step_template")

  @@unique([workflow_template_id, step_number], map: "uq_workflow_step_template_number")
  @@index([workflow_template_id], map: "idx_workflow_step_template")
}

model workflow_assignment {
  id                   Int                        @id @default(autoincrement())
  workflow_template_id Int
  user_id              Int
  assigned_by_id       Int
  status               String                     @default("InProgress") @db.VarChar(20)
  assigned_at          DateTime                   @default(now()) @db.Timestamptz(6)
  completed_at         DateTime?                  @db.Timestamptz(6)
  notes                String?
  assigned_by          users                      @relation("WorkflowAssignmentAssignedBy", fields: [assigned_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_workflow_assignment_assigned_by")
  workflow_template    workflow_template          @relation(fields: [workflow_template_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_workflow_assignment_template")
  user                 users                      @relation("WorkflowAssignmentUser", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_workflow_assignment_user")
  assignment_steps     workflow_assignment_step[]

  @@unique([user_id, workflow_template_id], map: "uq_workflow_assignment_user_template")
  @@index([user_id], map: "idx_workflow_assignment_user")
  @@index([workflow_template_id], map: "idx_workflow_assignment_template")
  @@index([status], map: "idx_workflow_assignment_status")
}

model workflow_assignment_step {
  id                     Int                 @id @default(autoincrement())
  workflow_assignment_id Int
  workflow_step_id       Int
  status                 String              @default("Pending") @db.VarChar(20)
  completed_at           DateTime?           @db.Timestamptz(6)
  completed_by_id        Int?
  notes                  String?
  workflow_assignment    workflow_assignment @relation(fields: [workflow_assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_workflow_assignment_step_assignment")
  completed_by           users?              @relation(fields: [completed_by_id], references: [user_id], onUpdate: NoAction, map: "fk_workflow_assignment_step_completed_by")
