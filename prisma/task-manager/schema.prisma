// Ebright Flow — Prisma schema
// Implements the build spec §4 + §4a, with the following deliberate additions
// (each one flagged in PROJECT_GUIDE.md §"Spec deviations"):
//   - Workspace model: spec §2 requires a Workspace → Flow → Run sidebar hierarchy,
//     but §4 had no Workspace table. Added, with department scoping for §6 multi-tenancy.
//   - FlowRun.templateSnapshot: spec snapshots only Flow.version (an Int). That does NOT
//     preserve template *content* — editing Block rows in place would still mutate in-flight
//     runs. The engine therefore snapshots the full executable template (nodes, edges,
//     blocks+items, decisions) at run start and reads ONLY from the snapshot.
//   - RunItem denormalizes type/label/required/config from the template item at run start,
//     for the same reason.
//   - Block.dueInHours: spec §5 schedules reminders relative to dueAt but nothing ever set
//     dueAt. dueAt = activatedAt + dueInHours (falls back to reminder cadence from activation).
//   - RunBlock.reminderJobId: lets completion cancel the pending BullMQ job by id (§5 requires
//     real job removal, not ignoring).
//   - AuditLog: §6 audit-trail requirement.
//   - Block.escalateToUserId is nullable in the DB but REQUIRED to publish a flow —
//     enforced by the publish validation, so half-built drafts can be saved.
//   - User ids on non-identity tables are plain strings (no FK relation): the User table
//     will eventually mirror OSC identities (§5a); loose coupling keeps that swap cheap.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/task-manager-client"
}

datasource db {
  provider = "postgresql"
}

// ---------- Identity ----------

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  role           Role           @default(MEMBER)
  department     String?
  branch         String? // org location dimension (e.g. "Subang Taipan") — analytics
  employmentType String? // HOD | Full Time | Part Time | Intern — display label, analytics
  // Direct link to ebright_hrfs."User"."id" (integer, 2026-07-31) — the
  // durable cross-database key, so joins no longer depend on emails
  // matching. Set by bootstrap from the HRFS source row; null for accounts
  // with no ebright_hrfs row (portal-only staff, site logins, TEST
  // accounts) or unresolved email mismatches.
  hrfsUserId Int?
  coachSchedule  String? // Full Time | Part Time — sub-split of employmentType "Coach" only;
  // used by the assign-task recipient picker's "By Group" filter, NOT by the
  // Branch Status by Region analytics (which still matches employmentType "Coach").
  createdAt        DateTime         @default(now())
  hodKanbanCards   HodKanbanCard[]
  hodKanbanColumns HodKanbanColumn[] // DEPT_SITE/BRANCH_SITE view-only site logins for

  @@index([hrfsUserId])
  // "Department accounts"/"Branch site accounts" (one department/branch's Status
  // view, no personal tasks) — see role usage below.
}

enum Role {
  ADMIN
  CEO
  OPS
  BRANCH
  HOD
  MEMBER
  DEPT_SITE // Department-level view-only login (e.g. "Finance Department") —
  // sees only that department's own Department Status Daily/Monthly + member
  // roster, no personal tasks, no assign form — EXCEPT the Operation
  // department's account, which additionally gets unrestricted Assign Task
  // (see /api/internal/assign's isOperationDeptSite check).
  BRANCH_SITE // Branch-level view-only login (e.g. "Subang Taipan") — sees only
  // that branch's own Branch Status Daily/Monthly + member roster, no
  // personal tasks, no assign form, no Manpower Schedule.
}

// One HOD's own freeform personal board — NOT the task engine (no
// RunBlock/FlowRun involved). 3 default columns (Pending/In Progress/
// Completed) get lazily persisted here as real HodKanbanColumn rows
// (owner-scoped ids) the first time that HOD's board is loaded (GET);
// after that they're ordinary rows — renamable and deletable the same as
// any custom column the HOD adds (HodKanbanColumn below). The HOD manually
// creates and drags cards for their own notes/reminders. `order` is a
// float (fractional-indexing style) so a drag to a specific position only
// ever needs to update the ONE moved card. `column` is either one of the 3
// fixed strings ("PENDING" | "IN_PROGRESS" | "COMPLETED") or a
// HodKanbanColumn's own id.
model HodKanbanCard {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  column    String
  title     String
  order     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, column])
}

// A column on an HOD's board: either one of the 3 defaults (Pending/In
// Progress/Completed), lazily created as a row here the first time that
// HOD's board is loaded (see HodKanbanCard above), or a custom column the
// HOD added afterward. Once created, default and custom columns are
// indistinguishable — every row here is equally renamable, reorderable,
// and deletable.
model HodKanbanColumn {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  label     String
  order     Float
  /** Preset key from HOD_KANBAN_COLORS (src/osc/types.ts), or null for the
   *  default neutral title — never a raw hex/CSS value. */
  color     String?
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// ---------- Template layer (design-time) ----------

model Workspace {
  id         String   @id @default(cuid())
  name       String
  icon       String? // emoji shown in the sidebar
  ownerId    String
  department String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  flows      Flow[]
}

model Flow {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  name          String
  icon          String? // emoji, for quick visual scanning in the sidebar
  description   String?
  ownerId       String
  department    String?
  order         Int            @default(0)
  nodes         Json           @default("[]") // React Flow nodes (block + decision), positions
  edges         Json           @default("[]") // React Flow edges; edge.data.condition per lib/types
  version       Int            @default(1)
  isPublished   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  triggers      FlowTrigger[]
  blocks        Block[]
  decisionNodes DecisionNode[]
  runs          FlowRun[]
  doc           FlowDoc?

  @@index([workspaceId])
}

model FlowTrigger {
  id     String      @id @default(cuid())
  flowId String
  flow   Flow        @relation(fields: [flowId], references: [id], onDelete: Cascade)
  type   TriggerType
  config Json // FORM_SUBMIT: form field schema; WORKFLOW_CHAIN: { sourceFlowId }

  @@index([flowId])
}

enum TriggerType {
  MANUAL
  FORM_SUBMIT
  WORKFLOW_CHAIN
}

// A Block = one node on canvas = a mini checklist for ONE PIC
model Block {
  id               String      @id @default(cuid())
  flowId           String
  flow             Flow        @relation(fields: [flowId], references: [id], onDelete: Cascade)
  nodeId           String // matches the React Flow node id in Flow.nodes
  title            String
  assigneeRole     String? // role/department placeholder, resolved at run time if not fixed
  fixedAssigneeId  String? // optional: always assign to this specific user
  dueInHours       Int? // dueAt = activation + dueInHours (see header note)
  reminderInterval Int         @default(24) // hours between reminders
  strikeLimit      Int         @default(3)
  escalateToUserId String? // supervisor; REQUIRED at publish time (validated, not by the DB)
  outgoingEdges    Json        @default("[]") // ConditionalEdge[] (lib/types) — first match wins
  items            BlockItem[]

  @@unique([flowId, nodeId])
}

model BlockItem {
  id       String   @id @default(cuid())
  blockId  String
  block    Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  order    Int
  type     ItemType
  label    String
  required Boolean  @default(true)
  config   Json     @default("{}") // per-type config, zod-validated (lib/item-schemas)

  @@index([blockId, order])
}

enum ItemType {
  CHECKBOX
  TEXT
  YES_NO
  NUMBER
  DROPDOWN
  DUE_DATE
  FILE_UPLOAD
  APPROVAL
  SUB_ASSIGNEE_TASK
  IMAGE_EMBED
}

// Decision node = flowchart diamond for multi-way branches
model DecisionNode {
  id         String @id @default(cuid())
  flowId     String
  flow       Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  nodeId     String
  conditions Json   @default("[]") // ConditionalEdge[] — ordered, first match wins, 'else' last

  @@unique([flowId, nodeId])
}

// ---------- Execution layer (run-time) ----------

model FlowRun {
  id               String      @id @default(cuid())
  flowId           String
  flow             Flow        @relation(fields: [flowId], references: [id])
  flowVersion      Int // Flow.version at start
  templateSnapshot Json // full executable template at start — engine reads ONLY this
  name             String // display name, e.g. "Client Onboarding — 16 Jul"
  startedById      String
  triggerType      TriggerType
  status           RunStatus   @default(ACTIVE)
  // Archive (2026-07-31): non-null = hidden from every active view
  // (fetchPeriodBlocks filters it) but fully retrievable/restorable —
  // unlike CANCELLED this is a first-class reversible state, cleared by
  // Unarchive. Orthogonal to `status` so completion history survives.
  archivedAt       DateTime?
  startedAt        DateTime    @default(now())
  completedAt      DateTime?
  runBlocks        RunBlock[]

  @@index([flowId, status])
  @@index([status, startedAt])
}

enum RunStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model RunBlock {
  id            String      @id @default(cuid())
  runId         String
  run           FlowRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  blockId       String // template Block id (as captured in the snapshot)
  nodeId        String // canvas node id — used for edge navigation within the snapshot
  title         String // denormalized for dashboard queries
  assigneeId    String
  status        BlockStatus @default(PENDING)
  dueAt         DateTime?
  strikeCount   Int         @default(0)
  reminderJobId String? // current pending BullMQ job id, cancelled on completion
  startedAt     DateTime?
  completedAt   DateTime?
  scheduleSlotId String? // set when this task was created by a Manpower Schedule slot sync
  runItems      RunItem[]
  // Explicit Daily/Monthly/Ad hoc tag, set ONLY by the "+ Add Task" quick-
  // assign form (assign/route.ts) for its 5 permitted actor roles. A task
  // gets EXACTLY ONE of these, never more — the form is single-select.
  // null (the default, and every pre-existing row from before this field
  // existed) means "untagged" — the OLD dueAt/startedAt date-window rule
  // (resolveWindow/fetchPeriodBlocks) still decides Daily/Monthly membership
  // for those, and the OLD starter-role check still decides Ad hoc
  // membership (getAdhocPayload/getAdhocRegionsPayload). A non-null value
  // means the tag ALONE decides Daily/Monthly membership — dueAt becomes
  // purely a deadline/overdue marker for these tasks — and ADHOC (settable
  // only when the assignee is a Branch Manager) ORs into the existing
  // starter-role Ad hoc check. Every other creation path (Manpower Schedule
  // slot sync, engine flow runs) leaves this at its default (null) and is
  // completely unaffected.
  cadence       Cadence?
  // Weekly auto-recurrence — "recurring series" model: when a DAILY block's
  // due day has passed, engine/recurrence.ts (hourly in-server sweep +
  // lazy catch-up on read) creates NEXT week's occurrence and links it back
  // via recurrenceOfId. The finished block is never touched, so per-day
  // history (the Daily date filter) keeps showing what actually happened.
  // recurrenceOfId is UNIQUE — at most ONE successor per block — making
  // concurrent catch-ups idempotent. Manpower-Schedule tasks
  // (scheduleSlotId set, cadence ADHOC) never qualify.
  //
  // repeatWeekly is RETIRED (2026-07-25 final decision: recurrence is
  // UNIVERSAL for Daily tasks — no opt-in). Column kept to avoid a
  // pointless destructive migration; nothing reads or writes it anymore.
  repeatWeekly   Boolean   @default(false)
  recurrenceOfId String?   @unique
  recurrenceOf   RunBlock? @relation("BlockRecurrence", fields: [recurrenceOfId], references: [id])
  successor      RunBlock? @relation("BlockRecurrence")

  // Optional SOP/reference material attached by the assigner (2026-07-30,
  // the "+ Task" Guideline section). ONE Guideline row is shared by every
  // block the assignment created (all recipients × days) and by weekly-
  // recurrence successors — the image bytes are stored once.
  guidelineId String?
  guideline   Guideline? @relation(fields: [guidelineId], references: [id])

  // Optional assignee-uploaded completion evidence (2026-07-30, the My
  // Tasks "Proof" column). Unlike guideline (shared, assigner-attached),
  // proof is strictly per-block and NEVER inherited by recurrence
  // successors — it's evidence for THIS occurrence only. One-to-many as of
  // 2026-08-08 (up to 5 photos per task, see Proof's own comment) —
  // formerly a single nullable Proof (runBlockId @unique).
  proofs Proof[]

  // Main Task ↔ Subtask link (2026-07-30): a subtask is a FULL RunBlock in
  // its own run (own status/proof/due — completion fully independent of
  // the parent, per the confirmed spec), created by the "+ Task" Subtasks
  // builder with parentId = the parent's block. Weekly recurrence advances
  // PARENTS only (engine/recurrence.ts skips parentId ≠ null) and clones
  // subtasks under the new parent. SET NULL on parent delete — an orphaned
  // subtask degrades to a normal top-level task.
  parentId String?
  parent   RunBlock?  @relation("BlockSubtasks", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  subtasks RunBlock[] @relation("BlockSubtasks")
  // Explicit checklist-builder sequence for SUBTASKS (2026-07-31, spec
  // delta B): 0-based position within the parent; copied by edit
  // propagation and weekly recurrence. Null on parents and on pre-column
  // subtasks — the UI falls back to creation (id) order for those.
  subtaskOrder Int?

  // Which TaskTemplate this block was created from (2026-07-31): set on
  // every block of an assignment that used "Start from a template" OR
  // "Save as Template" (the originating assignment). Plain string, no FK —
  // same loose coupling as user ids — so template deletion can cancel the
  // template's PENDING assignments (see deleteTaskTemplate) while
  // completed history keeps its (now dangling) reference untouched.
  templateId String?

  // Task Category ("Type", 2026-08-12): set ONCE at assignment time, never
  // edited afterward — the source of truth for which category this task
  // instance shows under. Optional on TaskTemplate too (an assign-form
  // pre-fill default only, never authoritative — see that model). SetNull
  // on category delete: an archived/deleted category never blocks or
  // orphans a task, it just falls back to "Uncategorized".
  categoryId String?
  category   TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([runId, nodeId])
  @@index([assigneeId, status])
  @@index([status, dueAt])
  @@index([runId])
  @@index([repeatWeekly, dueAt])
  @@index([parentId])
  @@index([templateId])
  @@index([categoryId])
}

/// Optional assigner-attached reference material for a task (link and/or
/// image, both optional — but a row only exists when at least one is set).
/// Image bytes live here in the DB (capped at 2 MB by the assign action)
/// so dev/staging/prod share them and Docker redeploys can't lose them;
/// served via /api/task-manager/guideline-image/[id] (session-gated).
model Guideline {
  id        String     @id @default(cuid())
  url       String?
  imageMime String? // image/png | image/jpeg | image/webp
  imageData Bytes?
  createdAt DateTime   @default(now())
  blocks    RunBlock[]
}

/// Task Categories ("Type", 2026-08-12): admin-managed, extensible task
/// grouping (Flowghan/CNS/SMS/Inventory/HRMS/Email Marketing, etc — no
/// fixed list, org-defined). Mirrors TaskTemplateGroup's shape (named,
/// ordered, reversibly archivable). Chosen ONCE at task-assignment time
/// (see RunBlock.categoryId below) — never edited on an existing task.
model TaskCategory {
  id          String         @id @default(cuid())
  name        String
  order       Int            @default(0)
  archivedAt  DateTime?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  runBlocks   RunBlock[]
  templates   TaskTemplate[]

  @@index([createdById])
}

enum TemplateGroupScope {
  TEMPLATE
  PACKAGE
}

/// Grouping layer for "Template Groups" (2026-08-06, /task-manager/template):
/// a named collection of several TaskTemplate rows, created/edited/deleted/
/// applied together. Each member task is an ORDINARY TaskTemplate row
/// (templateGroupId set below) — this model adds nothing but the name and
/// owner; all cascade-safety (pending-assignment cancellation, edit
/// propagation) is delegated to the existing per-task functions in
/// data/templates.ts. Distinct from the single-task TaskTemplate flow
/// ("+ Task → Start from a template"), which never sees grouped rows —
/// listTaskTemplates excludes templateGroupId != null.
model TaskTemplateGroup {
  id          String              @id @default(cuid())
  createdById String
  name        String
  scope       TemplateGroupScope @default(TEMPLATE)
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  templates       TaskTemplate[]
  branchSchedules BranchPackageSchedule[]

  @@index([createdById])
  @@index([scope])
}

enum PackageScheduleWeekday {
  WED
  THU
  FRI
  SAT
  SUN
}

/// Branch Package Schedule (2026-08-07, multi-package cells 2026-08-08):
/// one durable config row per (branch, weekday, packageGroupId) — a branch
/// can now have MULTIPLE Packages (each a PACKAGE-scope TaskTemplateGroup)
/// running the same weekday, so a given (branch, weekday) cell may be
/// backed by more than one row, one per configured package. Together
/// these rows are the standing source of truth the grid reads/writes.
/// Setting a cell creates this config row; the real recurring
/// cadence:"daily" assignment per package via the existing engine
/// (src/task-manager/data/branch-package-schedule.ts) is a SEPARATE step
/// as of 2026-08-11 (Save/Assign split, see assignedAt below) — Save no
/// longer creates it automatically for additions, only the explicit
/// "Assign" action does (removals are the one exception and still cancel
/// immediately). This row is the durable "what's configured" record, separate from the
/// FlowRun/RunBlock rows the recurrence engine perpetuates weekly (those
/// get replaced/cloned forward every week, this row does not). Note:
/// PackageScheduleWeekday (WED/THU/FRI/SAT/SUN, 5 values) is NOT the same
/// day-set as the TS FLOW_DAYS union (src/task-manager/ui/types.ts,
/// Tue/Wed/Thu/Fri/Sat/Sun, 6 values, used by the regular Task assign
/// flow's day picker) — FLOW_DAYS additionally includes Tuesday; don't
/// conflate the two or copy-paste one where the other belongs.
model BranchPackageSchedule {
  id             String                 @id @default(cuid())
  branch         String
  weekday        PackageScheduleWeekday
  packageGroupId String
  packageGroup   TaskTemplateGroup      @relation(fields: [packageGroupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdById    String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  /// null = configured (via Save) but not yet processed into a real
  /// recurring task assignment; non-null = the "Assign" action has already
  /// created the real assignment for this row (2026-08-11 Save/Assign
  /// split — see branch-package-schedule.ts's file header, added in the
  /// same split's data-layer step). Intended lifecycle (established by
  /// that step's code, not by this column alone): reset to null only by
  /// deleting and recreating the row (i.e. removing then re-adding the
  /// same package via Save) — never mutated back to null in place.
  assignedAt     DateTime?

  @@unique([branch, weekday, packageGroupId])
  @@index([branch, weekday])
  @@index([packageGroupId])
}

/// Reusable "+ Task" template (2026-07-31): captures the STRUCTURE of an
/// assignment — task title, subtasks, cadence, guideline link/image — but
/// deliberately NOT recipients, days, due date, or any completion state
/// (those reset per use). Owned by its creator (createdById, TM user id);
/// each assigner manages their own set. Saving with an existing name
/// OVERWRITES that template (that's the "edit" path). Using a template
/// only pre-fills the form — assignment then flows through the normal
/// pipeline (fresh Guideline row per assignment), never mutating this row.
model TaskTemplate {
  id             String   @id @default(cuid())
  createdById    String
  name           String
  title          String
  subtasks       Json     @default("[]") // string[]
  cadence        Cadence?
  guidelineUrl   String?
  guidelineMime  String? // image/png | image/jpeg | image/webp
  guidelineImage Bytes?
  // Archive (2026-07-31): archived templates leave the assign picker and
  // every hub tab except Archive (where Unarchive restores them + their
  // archived instances). Reversible counterpart to deletion.
  archivedAt     DateTime?
  // Template Groups (2026-08-06): set when this task is a member of a
  // TaskTemplateGroup — null for standalone single-task templates (all
  // pre-existing rows, and every row created outside the group flow).
  // groupPosition is the 0-based display order within the group.
  templateGroupId String?
  groupPosition   Int?
  group           TaskTemplateGroup? @relation(fields: [templateGroupId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  // Task Category pre-fill default (2026-08-12): only used to pre-fill the
  // assign form's Category dropdown when this template is picked — the
  // REAL, authoritative value is set per-assignment on RunBlock.categoryId
  // above and can diverge from this at any time without updating the
  // template.
  categoryId String?
  category   TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdById])
  @@index([templateGroupId])
}

/// Assignee-uploaded completion evidence for a RunBlock (a screenshot —
/// image only, capped at 2 MB by the upload action). Optional: uploading
/// proof never gates completion. One-to-many as of 2026-08-08 — up to 5
/// rows per RunBlock (app-enforced cap, not a DB constraint; runBlockId is
/// deliberately NOT unique, see @@index below). Each upload APPENDS a new
/// row rather than replacing one; removing a single photo is a separate
/// explicit action that deletes just that row and trashes just that row's
/// Drive file. Deleting the block cascades all of its proof rows away.
/// Images live in Google Drive (2026-08-04 storage decision — high upload
/// volume made in-DB bytes impractical) — driveFileId is the sole
/// reference for every upload; served via
/// /api/task-manager/proof-image/[id] (session-gated), which proxies from
/// Drive and needs no changes for the multi-row shape since it's already
/// keyed on this model's own id, not runBlockId. The original in-DB-bytes
/// columns (imageMime/imageData) were dropped 2026-08-04 after their only
/// 7 rows (pre-dating the Drive cutover, all test data) were deleted —
/// every surviving/future row goes through Drive.
///
/// NOTE for readers auditing this commit in isolation: the schema/relation
/// change here (runBlockId losing @unique, RunBlock.proof -> proofs) is
/// step 1 of 3 on this feature branch. The application code that reads/
/// writes this relation (src/task-manager/data/tasks.ts's upload path,
/// src/task-manager/analytics/_lib.ts's query + DTO shape, and the UI)
/// still assumes the old 1:1 shape as of this commit and does not yet
/// compile clean — that's intentional, fixed by the next two commits on
/// this same branch, not an accidental break.
model Proof {
  id          String   @id @default(cuid())
  runBlockId  String
  runBlock    RunBlock @relation(fields: [runBlockId], references: [id], onDelete: Cascade)
  driveFileId String? // Google Drive file id — set by every upload
  createdAt   DateTime @default(now())

  @@index([runBlockId])
}

enum BlockStatus {
  PENDING
  ACTIVE
  OVERDUE
  ESCALATED
  DONE
  SKIPPED
}

enum Cadence {
  DAILY
  MONTHLY
  // Set ONLY on tasks assigned (via /api/internal/assign) to a Branch
  // Manager assignee — the one branch-side role that keeps all 3 cadence
  // options. Coach/Branch Exec assignees never get this value (their
  // Cadence field only ever offers Daily). getAdhocPayload/
  // getAdhocRegionsPayload OR this tag in alongside the pre-existing
  // starter-role === BRANCH check.
  ADHOC
}

model RunItem {
  id          String    @id @default(cuid())
  runBlockId  String
  runBlock    RunBlock  @relation(fields: [runBlockId], references: [id], onDelete: Cascade)
  itemId      String // template BlockItem id (as captured in the snapshot)
  order       Int
  type        ItemType // denormalized from the snapshot — immune to template edits
  label       String
  required    Boolean
  config      Json      @default("{}")
  value       Json? // typed answer, shape per lib/item-schemas value schema
  completedAt DateTime?
  completedBy String?

  @@index([runBlockId, order])
}

model NotificationLog {
  id         String   @id @default(cuid())
  runBlockId String
  type       String // REMINDER | ESCALATION
  sentTo     String
  sentAt     DateTime @default(now())
  jobId      String // BullMQ job id, for tracing/debugging

  @@index([runBlockId])
}

// §6 audit trail: who did what, when — answerable without digging through email
model AuditLog {
  id         String   @id @default(cuid())
  runId      String?
  runBlockId String?
  actorId    String // user id, or "system" for engine/worker actions
  action     String // RUN_STARTED | RUN_COMPLETED | RUN_CANCELLED | ITEM_COMPLETED | ITEM_CLEARED | BLOCK_STATUS_CHANGED | BLOCK_ESCALATED | BLOCK_REASSIGNED | BLOCK_RECURRED | BLOCK_AUTO_REFRESH (historical only) | REMINDER_SENT
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([runId, createdAt])
  @@index([runBlockId])
}

// ---------- §4a Wiki page + saved dashboard views ----------

// One attached doc per Flow — SOP notes/context; deliberately NOT versioned with Flow.version
model FlowDoc {
  id        String   @id @default(cuid())
  flowId    String   @unique
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  content   Json // BlockNote document JSON
  updatedAt DateTime @updatedAt
  updatedBy String
}

model SavedView {
  id        String   @id @default(cuid())
  userId    String
  name      String
  viewType  ViewType
  filters   Json     @default("{}") // status, assignee, flow, overdue-only, etc.
  sortBy    String?
  isDefault Boolean  @default(false)

  @@index([userId])
}

enum ViewType {
  TABLE
  BOARD
  CALENDAR
}

// ---------- Manpower schedule (OSC bridge) ----------

// A branch manager's weekly/daily staffing grid: rows are time slots,
// columns are role seats (Manager / Coach N / Exec N, configurable per
// branch). One row per (branch, date). Assignments only sync to the task
// engine once PUBLISHED — PLANNING is a draft the branch manager can edit
// freely without notifying anyone.
model ManpowerSchedule {
  id          String         @id @default(cuid())
  branch      String
  date        String // YYYY-MM-DD
  status      ScheduleStatus @default(PLANNING)
  createdById String
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  slots       ScheduleSlot[]

  @@unique([branch, date])
}

enum ScheduleStatus {
  PLANNING
  PUBLISHED
}

// One grid cell: a (time row × role column) pair. assignedStaffId is who's
// on that seat for that slot; runBlockId is the linked ad hoc task once the
// schedule is published and the cell is assigned — kept in sync on every
// reassignment/unassignment/time edit (see src/app/api/internal/_manpower.ts).
model ScheduleSlot {
  id              String           @id @default(cuid())
  scheduleId      String
  schedule        ManpowerSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  startTime       String // HH:mm
  endTime         String // HH:mm
  // Optional row label (2026-08-01, ClickUp-style slot naming): "Opening",
  // "6:00 PM Class", "Closing" — typed by the Branch Manager per TIME ROW
  // (stored on every cell of that row, kept uniform by the row actions).
  // Synced task titles use it; rows without one fall back to
  // "{h:mm AM/PM} Class" auto-formatted from startTime (slotTaskTitle).
  rowLabel        String?
  roleColumn      String // "Manager" | "Coach 1" | "Exec 1" | ...
  assignedStaffId String?
  runBlockId      String?
  updatedAt       DateTime         @updatedAt

  @@unique([scheduleId, startTime, endTime, roleColumn])
  @@index([scheduleId])
}

// ---------- CEO dashboard customization (OSC bridge) ----------

// One row per CEO user PER CADENCE ("daily" | "monthly"): which departments
// they've pinned to that Kanban board, and in what order. The Daily and
// Monthly boards are fully independent — adding/removing/reordering on one
// never touches the other. Personal to that CEO — doesn't affect
// Superadmin's or anyone else's view. `departments` is an ordered JSON
// string array of official department names.
model CeoDashboardConfig {
  id          String   @id @default(cuid())
  userId      String
  cadence     String
  departments Json     @default("[]")
  updatedAt   DateTime @updatedAt

  @@unique([userId, cadence])
}
