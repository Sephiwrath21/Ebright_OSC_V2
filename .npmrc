legacy-peer-deps=true

# The production deploy builds this image on the small deploy host, where a
# single ECONNRESET mid-install kills `npm ci` and takes the whole deploy with
# it (run 33814555725, 2026-09-03: the staging->main merge for PR #126 never
# reached prod). npm's defaults give up after 2 quick retries — stretch them so
# a transient registry reset is ridden out instead of failing the release.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
