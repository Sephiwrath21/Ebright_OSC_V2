# Template for the .env this app needs. Copy to .env and fill in real values.
#
# IMPORTANT for deployments: .env is git-ignored, so it is never pulled by
# scripts/deploy-staging.sh. Each host keeps its own copy, and docker-compose
# feeds it to the container via `env_file: .env`. A variable added locally does
# NOT reach the server — it has to be added to the server's .env by hand, then
# `docker compose up -d` to restart with it.

# --- Auth / primary database (Prisma — src/lib/prisma.ts) ---
DATABASE_URL=postgresql://user:password@host:5432/hrfs?schema=public

# Extra connection strings (kept for reference; current code does NOT read these)
LEADS_DB_URL=postgres://user:password@host:5432/ebrightleads_db
HRFS_DATABASE_URL=postgresql://user:password@host:5432/hrfs?schema=public
FA_DATABASE_URL=postgres://user:password@host:5432/ebrightleads_db
SMS_DATABASE_URL=postgres://user:password@host:5432/sms_syllabus

# --- NextAuth ---
# Also the canonical origin password-reset links are built against (see
# resolveBaseUrl in src/app/forgot-password/password-reset-actions.ts). It is
# preferred over the request Host header on purpose — Host is attacker-supplied
# and trusting it allows reset-link poisoning — so this MUST be the real public
# URL of this deployment, or emailed links will point somewhere useless.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- Outgoing mail (src/lib/mailer.ts) ---
# Required for /forgot-password to deliver anything. Without these the reset
# page reports "Failed to send reset link. Please contact support." in
# production; in development it falls back to printing the link to the console.
#
# ebright.my is on Google Workspace (MX -> aspmx.l.google.com), so smtp.gmail.com
# is correct — only USER/PASS change. SMTP_PASS must be a Google App Password
# (https://myaccount.google.com/apppasswords), not the account password: 16
# letters, spaces optional (the mailer strips them). A wrong value returns EAUTH,
# which arms a 10-minute app-wide send cooldown.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="od@ebright.my"
SMTP_PASS=""
SMTP_FROM_NAME="Ebright OD"

# Optional fallback transport, tried when SMTP fails or is unset.
# CRM_RESEND_API_KEY=""
# CRM_FROM_EMAIL="noreply@ebright.my"

# --- Google Drive service account (induction evidence / attachments) ---
GOOGLE_DRIVE_SA_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=

# --- External Ebright HRFS database (src/lib/ebright-hrfs.ts) ---
EBRIGHT_HRFS_HOST=
EBRIGHT_HRFS_PORT=5432
EBRIGHT_HRFS_USER=
EBRIGHT_HRFS_PASSWORD=
EBRIGHT_HRFS_DATABASE=hrfs

# --- External Ebright Leads database (src/lib/ebrightleads.ts) ---
EBRIGHTLEADS_HOST=
EBRIGHTLEADS_PORT=5432
EBRIGHTLEADS_USER=
EBRIGHTLEADS_PASSWORD=
EBRIGHTLEADS_DATABASE=ebrightleads_db

# --- HikVision attendance scanners (shared creds; devices come from DB) ---
HIKVISION_USER=
HIKVISION_PASS=

# --- ClickUp integration (https://app.clickup.com/settings/apps) ---
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
