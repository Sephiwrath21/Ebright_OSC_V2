# CEP runs as its own isolated process (see AGENTS.md) — this file is
# separate from the portal's own .env and never shares a value with it.

# Isolated SQLite DB, local to this app only. Never point this at the
# portal's Postgres DATABASE_URL.
DATABASE_URL="file:./dev.db"

# Gmail SMTP (nodemailer) — used for parent-facing email sends.
GMAIL_USER=
GMAIL_APP_PASSWORD=
TEST_EMAIL=

# Base URL this app is reachable at (used to build links in outgoing emails).
APP_BASE_URL="http://localhost:3010"

# Cal.com integration (festive/showcase calendar sync).
CALCOM_API_KEY=
CALCOM_API_URL=
