# Flowghan (apps/doomtracker) backend config. Copy to `.env` and fill in.
# The real .env is git-ignored (never committed). Flowghan runs as its own
# process; the portal reverse-proxies /flowghan-embed/* to it (see next.config.ts).

# Postgres (Flowghan uses the doomtracker.* schema).
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Port this server listens on. The portal's FLOWGHAN_APP_ORIGIN must point here
# (default http://localhost:3020).
PORT=3020

# Auth + email.
JWT_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_RECIPIENT=

# Extra browser origins allowed to call this API directly (comma-separated).
# Not needed when embedded (same-origin via the portal proxy); leave blank.
CORS_ORIGINS=
